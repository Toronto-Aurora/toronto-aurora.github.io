---
import Base from '../layouts/Base.astro';
import fellowships from '../data/fellowships.json';

const groups = [
  {
    kicker: 'Our activities',
    title: 'Cross-institutional research life',
    intro: 'Shared activities across DADDAA, Dunlap, CITA, and York.',
    items: [
      { id: 'meeting', icon: 'ti-users', cls: 'teal', title: 'Weekly cross-institutional group meeting', blurb: 'Where the whole group meets, every week.', body: 'A weekly meeting that brings together DADDAA, Dunlap, CITA, and York, with rotating presenters spanning observation, theory, and data science. It is the first stop for new members and visitors.' },
      { id: 'daa-colloq', icon: 'ti-presentation', cls: 'blue', title: 'DADDAA Colloquium', blurb: 'The department colloquium series at U of T.', body: 'The David A. Dunlap Department of Astronomy & Astrophysics colloquium: weekly talks by leading visitors from around the world, with Aurora members and visitors as regular speakers and attendees.', link: 'https://www.astro.utoronto.ca/daa-events/upcoming-colloquium-talks/' },
      { id: 'cita-colloq', icon: 'ti-presentation', cls: 'violet', title: 'CITA Colloquium', blurb: 'CITA’s theoretical astrophysics series.', body: 'The Canadian Institute for Theoretical Astrophysics colloquium series, covering cosmology, galaxy formation, and theoretical astrophysics.', link: 'https://www.cita.utoronto.ca/events/event-calendar/' },
      { id: 'york-colloq', icon: 'ti-presentation', cls: 'amber', title: 'York Physics & Astronomy Colloquium', blurb: 'York University’s departmental colloquium series.', body: 'The York University Department of Physics and Astronomy colloquium series, covering astrophysics, cosmology, and physics, and a regular meeting point for Aurora members based at York.', link: 'https://www.yorku.ca/science/physics/colloquia/' },
    ],
  },
  {
    kicker: 'For international researchers',
    title: 'Visiting Aurora',
    intro: 'Several funded routes bring researchers from abroad to Toronto, from short visits to full terms.',
    items: [
      { id: 'dunlap-visitor', icon: 'ti-plane', cls: 'blue', title: 'Dunlap Visitor Program', blurb: 'Funded visits hosted by the Dunlap Institute.', body: 'The Dunlap Institute hosts visiting researchers for short and longer stays. Aurora members can co-host visitors through this program.', link: 'https://dunlap.utoronto.ca/visitors/' },
      { id: 'cita-visitor', icon: 'ti-plane', cls: 'teal', title: 'CITA Visitor Program', blurb: 'Visiting positions in theoretical astrophysics.', body: 'CITA hosts visiting scientists and long-term visitors in theoretical astrophysics, a natural home for theory-focused collaborators.', link: 'https://www.cita.utoronto.ca/opportunities/opportunities-overview/' },
      { id: 'cita-mou', icon: 'ti-file-text', cls: 'violet', title: 'CITA Memorandum of Understanding', blurb: 'Partner-institution visitor exchange.', body: 'CITA maintains agreements (MoUs) with partner institutions that support visitor exchange, giving members established routes to bring in international collaborators.' },
      { id: 'mitacs-globalink', icon: 'ti-world', cls: 'teal', title: 'Mitacs Globalink', blurb: 'Funded research stays in Canada for international students and postdocs.', body: 'Mitacs Globalink funds researchers from abroad to work at Canadian universities, including U of T and York. The Globalink Research Award supports graduate students and postdoctoral fellows for research projects of 12 to 48 weeks under joint home and host supervision (CA$6,000 per 12 to 24 week unit), and the Globalink Research Internship brings international undergraduates for 12-week summer projects. Aurora members can host visitors through these programs.', link: 'https://www.mitacs.ca/our-programs/globalink-research-award/' },
      { id: 'aurora-visitor', icon: 'ti-plane', cls: 'amber', title: 'Aurora Visitor Program', blurb: 'Aurora’s own funded visitor program.', badge: 'Coming soon', body: 'Aurora is preparing its own funded visitor program, planned in tiers: short senior-collaborator visits, a graduate summer program, and semester-style embedded postdoc visits (the first tier is a pilot of two to three visitors per year, two to four weeks, with travel and accommodation supported). Terms and the application window will be announced.' },
    ],
  },
  {
    kicker: 'For early-career researchers',
    title: 'Offers for students and postdocs',
    intro: 'Funding and mentorship arrangements that let Toronto compete with longer offers elsewhere.',
    items: [
      { id: 'extension', icon: 'ti-calendar-plus', cls: 'violet', title: 'Fellowship extension (+1 year)', blurb: 'A funded third year for two-year fellows, where we can arrange it.', special: 'fellowships', body: 'Many competitive fellowships run only two years, which is short for building an independent research line. Where we can, Aurora adds a funded third year. We cannot promise it in advance, since it depends on the funding available at the time. Working across two universities does give us more places to look than any single group has. If a third year would matter for you, get in touch early and we will see what we can put together. Eligible awards include the U of T fellowships and the international programs below.' },
      { id: 'co-mentorship', icon: 'ti-arrows-exchange', cls: 'teal', title: 'Co-mentorship', blurb: 'A second mentor from another pillar, if you want one.', body: 'We offer postdocs a second mentor from a different pillar, and we will help arrange it. Take it if you want it. It works best when set up early, because both mentors are then involved in the research from the start. Postdocs also mentor students directly.' },
      { id: 'career', icon: 'ti-stairs-up', cls: 'amber', title: 'Career support', blurb: 'Dual mentoring, training, and placement.', body: 'Beyond research: dual mentoring, professional-development sessions tied to Dunlap activities, postdoc-led lectures, and an annual internal review where trainees present and get feedback. As cohorts graduate, placement outcomes are tracked and shown openly.' },
    ],
  },
];
---
<Base title="Programs — Aurora Initiative" description="Shared activities, visitor programs, fellowship extensions, co-mentorship, and career support at the Aurora Initiative.">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker" style="color:#84e6ca;">Programs &amp; opportunities</div>
      <h1>Programs</h1>
      <p>Shared activities, routes for visiting researchers, and support for early-career people. Click any item for details.</p>
    </div>
  </section>

  <section class="section" style="padding-top:44px;">
    <div class="wrap">
      {groups.map((g) => (
        <div class="prog-group" id={g.kicker === 'For international researchers' ? 'visitors' : undefined}>
          <div class="section-head" style="margin-bottom:0;">
            <div class="kicker">{g.kicker}</div>
            <h2>{g.title}</h2>
            <p>{g.intro}</p>
          </div>
          <div class="acc-list">
            {g.items.map((it) => (
              <details class="acc" id={it.id}>
                <summary class="acc-sum">
                  <span class="acc-ic" style={`background:var(--pill-${it.cls}-bg);color:var(--pill-${it.cls}-fg)`}><i class={`ti ${it.icon}`}></i></span>
                  <span class="acc-txt">
                    <span class="acc-title">{it.title}{it.badge && (<span class="acc-badge">{it.badge}</span>)}</span>
                    <span class="acc-blurb">{it.blurb}</span>
                  </span>
                  <i class="ti ti-chevron-down acc-chev"></i>
                </summary>
                <div class="acc-body">
                  <p>{it.body}</p>
                  {it.special === 'fellowships' && (
                    <>
                      <h4 class="acc-h">Eligible U of T fellowships</h4>
                      <table class="ftable">
                        <tbody>
                          {fellowships.uoft.map((f) => (<tr><td>{f.name}</td><td>{f.region}</td><td><a href={f.url} target="_blank" rel="noopener">Details ↗</a></td></tr>))}
                        </tbody>
                      </table>
                      <h4 class="acc-h">International fellowships you can bring to Toronto, including:</h4>
                      <table class="ftable">
                        <tbody>
                          {fellowships.international.map((f) => (<tr><td>{f.name}</td><td>{f.region}</td><td><a href={f.url} target="_blank" rel="noopener">Details ↗</a></td></tr>))}
                        </tbody>
                      </table>
                    </>
                  )}
                  {it.link && (<a class="link-more" href={it.link} target="_blank" rel="noopener">Learn more <i class="ti ti-arrow-right"></i></a>)}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="prog-group" id="join">
        <div class="section-head" style="margin-bottom:0;">
          <div class="kicker">Join us</div>
          <h2>Get in touch</h2>
        </div>
        <div class="callout" style="max-width:860px;">
          <strong>Contact.</strong> If you are considering a postdoc or PhD on the first billion years, or hold (or are applying for) a fellowship you would bring to Toronto, email <a href="mailto:seiji.fujimoto@utoronto.ca">seiji.fujimoto@utoronto.ca</a> with a short note on your interests and which mentors or pillars you would want to work across. A shared address (info@aurorainstitute.ca) will replace this once the domain is set up.
        </div>
      </div>
    </div>
  </section>

  <script>
    const h = decodeURIComponent(location.hash.slice(1));
    if (h) {
      const el = document.getElementById(h);
      if (el && el.tagName === 'DETAILS') { el.open = true; setTimeout(() => el.scrollIntoView({ block: 'center' }), 40); }
    }
  </script>
</Base>
