---
import Base from '../layouts/Base.astro';
import fellowships from '../data/fellowships.json';

const groups = [
  {
    kicker: 'Our activities',
    title: 'Cross-institutional research life',
    intro: 'Shared activities across DADDAA, Dunlap, CITA, and York.',
    items: [
      { id: 'meeting', icon: 'ti-users', cls: 'teal', title: 'Weekly group meeting', blurb: 'The first stop for new members and visitors.', body: 'Members from DADDAA, Dunlap, CITA, and York meet each week. Presenters rotate across observation, theory, and data science.' },
      { id: 'daa-colloq', icon: 'ti-presentation', cls: 'blue', title: 'DADDAA Colloquium', blurb: 'The departmental colloquium at U of T.', body: 'Weekly talks by invited visitors from around the world. Aurora members and visitors regularly speak and attend.', link: 'https://www.astro.utoronto.ca/daa-events/upcoming-colloquium-talks/' },
      { id: 'cita-colloq', icon: 'ti-presentation', cls: 'violet', title: 'CITA Colloquium', blurb: 'CITA’s theoretical astrophysics series.', body: 'The Canadian Institute for Theoretical Astrophysics hosts talks on cosmology, galaxy formation, and theoretical astrophysics.', link: 'https://www.cita.utoronto.ca/events/event-calendar/' },
      { id: 'york-colloq', icon: 'ti-presentation', cls: 'amber', title: 'York Physics & Astronomy Colloquium', blurb: 'York University’s departmental colloquium.', body: 'Talks in astrophysics, cosmology, and physics. As with the DADDAA and CITA series, members from both universities are welcome.', link: 'https://www.yorku.ca/science/physics/colloquia/' },
    ],
  },
  {
    kicker: 'For international researchers',
    title: 'Visiting Aurora',
    intro: 'Researchers from abroad can visit Toronto through several programs, from short stays to full terms.',
    items: [
      { id: 'dunlap-visitor', icon: 'ti-plane', cls: 'blue', title: 'Dunlap Visitor Program', blurb: 'Funded visits hosted by the Dunlap Institute.', body: 'The Dunlap Institute hosts researchers for short and longer stays. Aurora members can co-host visitors through this program.', link: 'https://dunlap.utoronto.ca/visitors/' },
      { id: 'cita-visitor', icon: 'ti-plane', cls: 'teal', title: 'CITA Visitor Program', blurb: 'Visits in theoretical astrophysics.', body: 'CITA hosts visiting scientists in theoretical astrophysics, including long-term visitors.', link: 'https://www.cita.utoronto.ca/opportunities/opportunities-overview/' },
      { id: 'cita-mou', icon: 'ti-file-text', cls: 'violet', title: 'CITA Memorandum of Understanding', blurb: 'Exchange visits with partner institutions.', body: 'CITA’s agreements (MoUs) with partner institutions support visitor exchanges and give members established routes to host international collaborators.' },
      { id: 'mitacs-globalink', icon: 'ti-world', cls: 'teal', title: 'Mitacs Globalink', blurb: 'Funded research stays in Canada for international researchers.', body: 'Mitacs Globalink funds researchers from abroad at Canadian universities, including U of T and York. The Globalink Research Award supports graduate students and postdoctoral fellows for research projects of 12 to 48 weeks under joint home and host supervision (CA$6,000 per 12 to 24 week unit). The Globalink Research Internship brings international undergraduates for 12-week summer projects. Aurora members can host visitors through these programs.', link: 'https://www.mitacs.ca/our-programs/globalink-research-award/' },
      { id: 'aurora-visitor', icon: 'ti-plane', cls: 'amber', title: 'Aurora Visitor Program', blurb: 'Aurora’s own visitor program, in preparation.', badge: 'Coming soon', body: 'Aurora is preparing its own visitor program. Terms will be announced here.' },
    ],
  },
  {
    kicker: 'For early-career researchers',
    title: 'Offers for students and postdocs',
    intro: 'Funding and mentoring arrangements for postdocs and students.',
    items: [
      { id: 'extension', icon: 'ti-calendar-plus', cls: 'violet', title: 'Fellowship extension (+1 year)', blurb: 'A funded third year for two-year fellows when funding allows.', special: 'fellowships', body: 'Many fellowships run for two years, which is short for building an independent research line. When funding allows, Aurora adds a funded third year. We cannot promise it in advance, because it depends on what is available at the time, but working across two universities gives us more places to look than a single group has. If a third year would matter to you, get in touch early. Eligible awards include the U of T fellowships and the international programs listed below.' },
      { id: 'co-mentorship', icon: 'ti-arrows-exchange', cls: 'teal', title: 'Co-mentorship', blurb: 'A mentor from another pillar, on request.', body: 'We offer postdocs an optional second mentor from a different pillar, arranged on request. This works best when set up early, so both mentors can be involved in the research from the start.' },
      { id: 'career', icon: 'ti-stairs-up', cls: 'amber', title: 'Career support', blurb: 'Dual mentoring and professional development, with opportunities to mentor students.', body: 'Support includes dual mentoring, professional-development sessions tied to Dunlap activities, postdoc-led lectures, and an annual internal review where you present your work and get feedback. Because Aurora sits alongside the programs that the department, Dunlap and CITA already run, there are many chances to mentor students, from summer undergraduate programs such as Dunlap SURP and the CITA fellowships to graduate supervision during term.' },
    ],
  },
];
---
<Base title="Programs — Aurora Initiative" description="Shared activities, visitor programs, fellowship extensions, co-mentorship, and career support at the Aurora Initiative.">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker" style="color:#84e6ca;">Programs and activities</div>
      <h1>Programs</h1>
      <p>Shared activities, routes for visiting researchers, and support for early-career researchers.</p>
    </div>
  </section>

  <section class="section" style="padding-top:44px;">
    <div class="wrap">
      {groups.map((g) => (
        <div class="prog-group" id={g.kicker === 'For international researchers' ? 'visitors' : undefined}>
          <div class="section-head" style="margin-bottom:0;">
            <div class="kicker">{g.kicker}</div>
            <h2>{g.title}</h2>
            <p>{g.intro}</p>
          </div>
          <div class="acc-list">
            {g.items.map((it) => (
              <details class="acc" id={it.id}>
                <summary class="acc-sum">
                  <span class="acc-ic" style={`background:var(--pill-${it.cls}-bg);color:var(--pill-${it.cls}-fg)`}><i class={`ti ${it.icon}`}></i></span>
                  <span class="acc-txt">
                    <span class="acc-title">{it.title}{it.badge && (<span class="acc-badge">{it.badge}</span>)}</span>
                    <span class="acc-blurb">{it.blurb}</span>
                  </span>
                  <i class="ti ti-chevron-down acc-chev"></i>
                </summary>
                <div class="acc-body">
                  <p>{it.body}</p>
                  {it.special === 'fellowships' && (
                    <>
                      <h4 class="acc-h">Eligible U of T fellowships</h4>
                      <table class="ftable">
                        <tbody>
                          {fellowships.uoft.map((f) => (<tr><td>{f.name}</td><td>{f.region}</td><td><a href={f.url} target="_blank" rel="noopener">Details ↗</a></td></tr>))}
                        </tbody>
                      </table>
                      <h4 class="acc-h">Examples of international fellowships you can bring to Toronto</h4>
                      <table class="ftable">
                        <tbody>
                          {fellowships.international.map((f) => (<tr><td>{f.name}</td><td>{f.region}</td><td><a href={f.url} target="_blank" rel="noopener">Details ↗</a></td></tr>))}
                        </tbody>
                      </table>
                    </>
                  )}
                  {it.link && (<a class="link-more" href={it.link} target="_blank" rel="noopener">Learn more <i class="ti ti-arrow-right"></i></a>)}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="prog-group" id="join">
        <div class="section-head" style="margin-bottom:0;">
          <div class="kicker">Join us</div>
          <h2>Get in touch</h2>
        </div>
        <div class="callout" style="max-width:860px;">
          <strong>Contact.</strong> If you are considering a postdoc or PhD on the first billion years, or hold or are applying for a fellowship you could bring to Toronto, email <a href="mailto:seiji.fujimoto@utoronto.ca">seiji.fujimoto@utoronto.ca</a> with a short note on your interests and the mentors or pillars you would like to work with. This address will be replaced by a shared one once we have our own domain.
        </div>
      </div>
    </div>
  </section>

  <script>
    const h = decodeURIComponent(location.hash.slice(1));
    if (h) {
      const el = document.getElementById(h);
      if (el && el.tagName === 'DETAILS') { el.open = true; setTimeout(() => el.scrollIntoView({ block: 'center' }), 40); }
    }
  </script>
</Base>
