---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import team from '../data/team.json';
import collab from '../data/collaborators.json';
import news from '../data/news.json';
import world from '../data/world.geo.json';

const questions = [
  { lead: 'Observation', pillar: 'observation', cls: 'teal', q: 'How did the first galaxies form and assemble?', d: 'JWST populations at z > 10 sit in tension with models of early star formation and feedback.' },
  { lead: 'Theory', pillar: 'theory', cls: 'violet', q: 'How did supermassive black holes grow so fast?', d: 'Luminous AGN at z > 7 imply massive seeds within a few hundred million years of the Big Bang.' },
  { lead: 'Data science', pillar: 'data', cls: 'blue', q: 'How did reionization proceed, and what drove it?', d: 'Source properties and IGM topology, jointly inferred from heterogeneous multi-survey data.' },
];
const motif = {
  observation: '<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3"><circle cx="50" cy="50" r="34"/><circle cx="50" cy="50" r="22"/><circle cx="50" cy="50" r="10"/><path d="M50 6V22M50 78V94M6 50H22M78 50H94M20 20L31 31M80 20L69 31M20 80L31 69M80 80L69 69"/></svg>',
  theory: '<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3"><circle cx="50" cy="50" r="6" fill="currentColor" stroke="none"/><ellipse cx="50" cy="50" rx="40" ry="15"/><ellipse cx="50" cy="50" rx="40" ry="15" transform="rotate(60 50 50)"/><ellipse cx="50" cy="50" rx="40" ry="15" transform="rotate(120 50 50)"/></svg>',
  data: '<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="20" y1="30" x2="50" y2="20"/><line x1="50" y1="20" x2="80" y2="38"/><line x1="20" y1="30" x2="35" y2="62"/><line x1="35" y1="62" x2="65" y2="72"/><line x1="65" y1="72" x2="80" y2="38"/><line x1="50" y1="20" x2="35" y2="62"/><line x1="65" y1="72" x2="82" y2="80"/><g fill="currentColor" stroke="none"><circle cx="20" cy="30" r="5"/><circle cx="50" cy="20" r="5"/><circle cx="80" cy="38" r="5"/><circle cx="35" cy="62" r="5"/><circle cx="65" cy="72" r="5"/><circle cx="82" cy="80" r="4"/></g></svg>',
};

const coordinators = team.tiers.find((t) => t.id === 'coordinators').members;
const initials = (n) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const visitorOffer = { icon: 'ti-plane', title: 'Visitor program', desc: 'Funded short-term visits to Toronto for collaborators and trainees.', cls: 'blue', href: '/programs#visitors' };
const postdocOffers = [
  { icon: 'ti-calendar-plus', title: '+1 year top-up', desc: 'A funded third year added to eligible two-year fellowships.', cls: 'violet', href: '/programs#extension' },
  { icon: 'ti-arrows-exchange', title: 'Co-mentorship', desc: 'Two mentors from different pillars for every trainee.', cls: 'teal', href: '/programs#co-mentorship' },
  { icon: 'ti-stairs-up', title: 'Career support', desc: 'Dual mentoring, training, and placement.', cls: 'amber', href: '/programs#career' },
];

const MW = 720, MH = 360;
const px = (lon) => Math.round(((lon + 180) / 360) * MW);
const py = (lat) => Math.round(((90 - lat) / 180) * MH);
const landPaths = [];
for (const f of world.features) {
  if (f.properties.name === 'Antarctica') continue;
  const g = f.geometry;
  const polygons = g.type === 'Polygon' ? [g.coordinates] : g.coordinates;
  for (const rings of polygons) {
    let d = '';
    for (const ring of rings) {
      let seg = '', lx = null, ly = null, count = 0;
      for (const c of ring) {
        const x = px(c[0]), y = py(c[1]);
        if (x === lx && y === ly) continue;
        seg += (count === 0 ? 'M' : 'L') + x + ' ' + y; lx = x; ly = y; count++;
      }
      if (count >= 3) d += seg + 'Z';
    }
    if (d) landPaths.push(d);
  }
}
const pts = collab.points.map((p) => ({ ...p, x: px(p.lon), y: py(p.lat) }));
const hub = pts.find((p) => p.hub) ?? pts[0];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (dt) => { const [y, m] = dt.split('-'); return MONTHS[parseInt(m, 10) - 1] + ' ' + y; };
const latest = news.items.slice(0, 4);
---
<Base>
  <Hero />

  <!-- OUR SCIENCE -->
  <section class="section" id="science">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Our science</div>
        <h2>Three connected questions about the first billion years</h2>
        <p>The galaxies that built up stellar mass are the same objects whose radiation drove reionization, and the black holes that grew alongside them shaped their hosts. Answering these together needs all three pillars.</p>
      </div>
      <div class="three">
        {questions.map((q) => (
          <article class="qcard">
            <div class="q-motif" style={`color:var(--pill-${q.cls}-fg)`} set:html={motif[q.pillar]}></div>
            <div class="q-inner">
              <div class="lead" style={`color:var(--pill-${q.cls}-fg)`}>{q.lead} lead</div>
              <h3>{q.q}</h3>
              <p>{q.d}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COORDINATORS -->
  <section class="section" id="coordinators" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">People</div>
        <h2>Coordinators</h2>
        <p>The team leading Aurora across both institutions and all three pillars.</p>
      </div>
      <div class="coord-grid">
        {coordinators.map((m) => (
          <a class="coord" href="/people">
            <span class="avatar-lg" style={`background:var(--pill-${({observation:'teal',theory:'violet',data:'blue'})[m.pillar] || 'teal'}-fg)`}>
              <span>{initials(m.name)}</span>
              {m.photo && (<img src={m.photo} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />)}
            </span>
            <span class="cname">{m.name}</span>
            <span class="caff">{m.affil}</span>
          </a>
        ))}
      </div>
      <div class="center-more"><a class="link-more" href="/people">Meet the full team <i class="ti ti-arrow-right"></i></a></div>
    </div>
  </section>

  <!-- WHAT AURORA OFFERS -->
  <section class="section" id="offer" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">What Aurora offers</div>
        <h2>Concrete support, by design</h2>
        <p>What makes Toronto competitive for the strongest early-career researchers, from the day they arrive.</p>
      </div>

      <div class="offer-group">
        <div class="og-kicker">For all researchers</div>
        <a class="feature-card" href={visitorOffer.href}>
          <span class="offer-ic" style={`background:var(--pill-${visitorOffer.cls}-bg);color:var(--pill-${visitorOffer.cls}-fg)`}><i class={`ti ${visitorOffer.icon}`}></i></span>
          <span class="fc-body">
            <h3>{visitorOffer.title}</h3>
            <p>{visitorOffer.desc}</p>
          </span>
          <span class="offer-more">Learn more <i class="ti ti-arrow-right"></i></span>
        </a>
      </div>

      <div class="offer-group">
        <div class="og-kicker">For postdoctoral researchers</div>
        <div class="og-cards trio">
          {postdocOffers.map((o) => (
            <a class="offer-card" href={o.href}>
              <span class="offer-ic" style={`background:var(--pill-${o.cls}-bg);color:var(--pill-${o.cls}-fg)`}><i class={`ti ${o.icon}`}></i></span>
              <h3>{o.title}</h3>
              <p>{o.desc}</p>
              <span class="offer-more">Learn more <i class="ti ti-arrow-right"></i></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- NETWORK + NEWS -->
  <section class="section" id="network" style="padding-top:0;">
    <div class="wrap">
      <div class="net-grid">
        <div class="panel">
          <h3><i class="ti ti-map-pin" style="color:var(--link)"></i> A global network, hosted in Toronto</h3>
          <p class="psub">Aurora brings international fellowships and visitors to Toronto and keeps members connected to research groups across the world.</p>
          <svg class="netmap" viewBox="0 40 720 250" role="img" aria-label="World map of collaborator locations centered on Toronto">
            <rect x="0" y="40" width="720" height="250" rx="12" fill="#0b1330" />
            <g fill="#1c294c" fill-rule="evenodd">
              {landPaths.map((d) => (<path d={d} />))}
            </g>
            {pts.filter((p) => !p.hub).map((p) => (<line x1={hub.x} y1={hub.y} x2={p.x} y2={p.y} stroke="#4b7fd0" stroke-width="0.8" opacity="0.6" />))}
            {pts.filter((p) => !p.hub).map((p) => (<circle cx={p.x} cy={p.y} r="3.6" fill="#5b8def" />))}
            <circle cx={hub.x} cy={hub.y} r="5.5" fill="#2dd4a7" />
            <circle cx={hub.x} cy={hub.y} r="11" fill="none" stroke="#2dd4a7" stroke-width="1" opacity="0.6" />
            <text x={hub.x + 12} y={hub.y + 4} font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="#7df3d0">Toronto</text>
          </svg>
        </div>
        <div class="panel">
          <h3><i class="ti ti-news" style="color:var(--link)"></i> Latest from Aurora</h3>
          {latest.map((n) => (
            <a class="news-item" href={n.url} target="_blank" rel="noopener">
              <span class="news-date">{fmt(n.date)}</span>
              <span class="news-text">{n.text}</span>
            </a>
          ))}
          <div style="margin-top:16px;"><a class="link-more" href="/news">All news <i class="ti ti-arrow-right"></i></a></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const ids = ['science', 'network'];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean);
    const links = new Map(Array.from(document.querySelectorAll('.nav-links a')).map((a) => [a.getAttribute('href'), a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.remove('active'));
          links.get('/#' + e.target.id)?.classList.add('active');
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => io.observe(s));
  </script>
</Base>
