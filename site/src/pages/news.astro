---
import Base from '../layouts/Base.astro';
import news from '../data/news.json';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (d) => { const [y, m] = d.split('-'); return MONTHS[parseInt(m, 10) - 1] + ' ' + y; };
const typeMeta = {
  paper: { label: 'Preprint', cls: 'teal', icon: 'ti-file-text' },
  award: { label: 'Award', cls: 'amber', icon: 'ti-award' },
  note: { label: 'News', cls: 'blue', icon: 'ti-sparkles' },
};
const items = [...news.items].sort((a, b) => (a.date < b.date ? 1 : -1));
const hay = (n) => [n.title, n.blurb, n.person, n.venue, n.venue ? 'published' : (n.type === 'paper' ? 'preprint' : ''), (typeMeta[n.type] || {}).label].filter(Boolean).join(' ').toLowerCase();
---
<Base title="News — Aurora Initiative" description="Preprints, talks, arrivals, awards, and meetings from across the Aurora Initiative.">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker" style="color:#84e6ca;">News</div>
      <h1>What's happening at Aurora</h1>
      <p>Preprints, talks, arrivals, awards, and meetings from across Aurora.</p>
    </div>
  </section>

  <section class="section" style="padding-top:36px;">
    <div class="wrap">
      <div class="news-toolbar">
        <div class="news-search">
          <i class="ti ti-search"></i>
          <input type="search" id="news-q" placeholder="Search papers, people, topics" aria-label="Search news" autocomplete="off" />
        </div>
        <div class="news-filters">
          <button class="nf-btn is-on" data-f="all">All</button>
          <button class="nf-btn" data-f="paper">Papers</button>
          <button class="nf-btn" data-f="award">Awards</button>
        </div>
      </div>

      <div class="news-grid" id="news-grid">
        {items.map((n) => {
          const tm = typeMeta[n.type] || typeMeta.note;
          const published = n.type === 'paper' && n.venue;
          const label = published ? n.venue : tm.label;
          const cls = published ? 'blue' : tm.cls;
          const icon = published ? 'ti-book-2' : tm.icon;
          return (
            <article class="ncard" data-type={n.type} data-search={hay(n)}>
              {n.type === 'paper' && n.figure && (
                <a class="ncard-fig" href={n.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                  <img src={n.figure} alt="" loading="lazy" />
                </a>
              )}
              {n.type === 'award' && n.photo && (
                <a class="ncard-photo" href={n.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                  <img src={n.photo} alt="" loading="lazy" />
                </a>
              )}
              <div class="ncard-body">
                <div class="ncard-top">
                  <span class="ncard-label" style={`background:var(--pill-${cls}-bg);color:var(--pill-${cls}-fg)`}><i class={`ti ${icon}`}></i> {label}</span>
                  <span class="ncard-date">{fmt(n.date)}</span>
                </div>
                <h3 class="ncard-title"><a href={n.url} target="_blank" rel="noopener">{n.title}</a></h3>
                {n.blurb && <p class="ncard-blurb">{n.blurb}</p>}
                <div class="ncard-foot">
                  <span class="ncard-person"><i class="ti ti-user"></i> {n.person}</span>
                  <a class="ncard-link" href={n.url} target="_blank" rel="noopener">{n.type === 'paper' ? 'ADS' : 'Details'} <i class="ti ti-arrow-up-right"></i></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <p class="news-empty" id="news-empty" hidden>No matching items.</p>
    </div>
  </section>

  <script>
    const q = document.getElementById('news-q');
    const cards = Array.from(document.querySelectorAll('.ncard'));
    const btns = Array.from(document.querySelectorAll('.nf-btn'));
    const empty = document.getElementById('news-empty');
    let filter = 'all';
    const apply = () => {
      const term = (q.value || '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const okType = filter === 'all' || c.dataset.type === filter;
        const okText = !term || (c.dataset.search || '').includes(term);
        const show = okType && okText;
        c.hidden = !show;
        if (show) shown++;
      });
      empty.hidden = shown > 0;
      empty.textContent = (filter === 'award' && !term) ? 'No awards to show yet. Member awards will be listed here as they happen.' : 'No matching items.';
    };
    q.addEventListener('input', apply);
    btns.forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.f;
      btns.forEach((x) => x.classList.toggle('is-on', x === b));
      apply();
    }));
  </script>
</Base>
