---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Aurora Initiative" description="The page you were looking for does not exist.">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker" style="color:#84e6ca;">404</div>
      <h1>Page not found</h1>
      <p>The page you were looking for does not exist or has moved.</p>
    </div>
  </section>
  <section class="section" style="padding-top:40px;">
    <div class="wrap">
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <a class="btn-join" href="/">Back to home</a>
        <a class="link-more" href="/people">People <i class="ti ti-arrow-right"></i></a>
        <a class="link-more" href="/programs">Programs <i class="ti ti-arrow-right"></i></a>
        <a class="link-more" href="/news">News <i class="ti ti-arrow-right"></i></a>
      </div>
    </div>
  </section>
</Base>
