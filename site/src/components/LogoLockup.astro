---
// Aurora Institute lockup — faithful to the approved artwork.
// The "A" is NOT a full triangle: only its LEFT leg is drawn (a gradient wedge).
// The RIGHT leg is the aurora arch itself, which rises from the right foot up to
// the apex and then keeps sweeping over the wordmark before fading out. The CN
// Tower stands in for the "i" of Institute. Wordmark + tower use `color`.
interface Props { height?: number; color?: string; }
const { height = 32, color = '#f4f7ff' } = Astro.props;
const tx = 634; // CN Tower x, centered over the dotless "i" of Institute (measured, Poppins 500 @ x=205)
---
<svg viewBox="0 0 920 140" height={height} role="img" aria-label="Aurora Institute" style={`height:${height}px;width:auto;display:block`}>
  <title>Aurora Institute</title>
  <defs>
    <linearGradient id="llV" gradientUnits="userSpaceOnUse" x1="70" y1="10" x2="70" y2="122">
      <stop offset="0" stop-color="#3fc8a8" />
      <stop offset="0.5" stop-color="#5385e6" />
      <stop offset="1" stop-color="#8f74ee" />
    </linearGradient>
    <linearGradient id="llSweep" gradientUnits="userSpaceOnUse" x1="76" y1="0" x2="906" y2="0">
      <stop offset="0" stop-color="#45bfbe" />
      <stop offset="0.5" stop-color="#3fc8a8" />
      <stop offset="1" stop-color="#3fc8a8" stop-opacity="0" />
    </linearGradient>
  </defs>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- right leg of the A = the arch rising from the right foot to the apex -->
    <path d="M100 122 C90 74 78 40 76 12" stroke="url(#llV)" stroke-width="5.5" />
    <!-- the same arch continues over the wordmark and fades out -->
    <path d="M76 12 C150 3 280 2 430 12 C620 24 800 48 906 62" stroke="url(#llSweep)" stroke-width="4.5" />
  </g>
  <!-- left leg (bold gradient wedge) -->
  <path fill="url(#llV)" d="M76 12 L28 122 L58 122 Z" />
  <!-- crossbar bridging the left leg to the arch -->
  <path fill="none" stroke="url(#llV)" stroke-width="6" stroke-linecap="round" d="M60 82 L90 82" />

  <!-- wordmark (dotless i so the tower stands in cleanly) -->
  <text x="205" y="100" font-family="'Poppins', Inter, sans-serif" font-size="74" font-weight="500" letter-spacing="1" fill={color}>Aurora Inst&#305;tute</text>

  <!-- CN Tower over the "i" of Institute -->
  <g fill={color} stroke="none">
    <path d={`M${tx - 0.8} 28 L${tx - 0.4} 6 L${tx} 4 L${tx + 0.4} 6 L${tx + 0.8} 28 Z`} />
    <ellipse cx={tx} cy="30" rx="2.6" ry="1.6" />
    <ellipse cx={tx} cy="39" rx="9" ry="3.2" />
    <path d={`M${tx - 7} 39 L${tx + 7} 39 L${tx + 3} 50 L${tx - 3} 50 Z`} />
    <path d={`M${tx - 3} 50 C${tx - 3.4} 72 ${tx - 5} 90 ${tx - 5.5} 100 L${tx + 5.5} 100 C${tx + 5} 90 ${tx + 3.4} 72 ${tx + 3} 50 Z`} />
  </g>
</svg>
