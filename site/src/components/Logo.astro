---
// Aurora Institute mark — "Aurora curtain A" (original working logo). Aurora gradient.
interface Props { size?: number; }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" role="img" aria-label="Aurora Institute" class="aurora-mark">
  <defs>
    <linearGradient id="auroraCurtain" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7df3d0" />
      <stop offset="0.5" stop-color="#5be08a" />
      <stop offset="1" stop-color="#a78bfa" />
    </linearGradient>
  </defs>
  <circle cx="7" cy="7" r="0.9" fill="#cdd9f5" opacity="0.7" />
  <circle cx="33" cy="9" r="1" fill="#cdd9f5" opacity="0.6" />
  <g fill="none" stroke="url(#auroraCurtain)" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 6 L9.5 34" />
    <path d="M20 6 L30.5 34" />
    <path d="M14 25 L26 25" />
  </g>
</svg>
